user nginx;                                                                                                                                                                                  
worker_processes auto;                                                                                                                                                                       
pid /var/run/nginx.pid;                                                                                                                                                                      
                                                                                                                                                                                             
events {                                                                                                                                                                                     
    worker_connections 1024;                                                                                                                                                                 
}                                                                                                                                                                                            
                                                                                                                                                                                             
http {                                                                                                                                                                                       
    include       /etc/nginx/mime.types;                                                                                                                                                     
    default_type  application/octet-stream;                                                                                                                                                  
    sendfile      on;                                                                                                                                                                        
    tcp_nopush    on;                                                                                                                                                                        
    keepalive_timeout 65;                                                                                                                                                                    
    server_tokens off;                                                                                                                                                                       
                                                                                                                                                                                             
    access_log /var/log/nginx/access.log;                                                                                                                                                    
    error_log  /var/log/nginx/error.log warn;                                                                                                                                                

    # Internal decoy site target for Xray VLESS-TLS fallback on :8443.
    server {
        listen 8085;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        location = /api {
            default_type application/json;
            return 401 '{"error":"Unauthorized"}';
        }
        location ^~ /api/ {
            default_type application/json;
            return 401 '{"error":"Unauthorized"}';
        }
        location = /v1 {
            default_type application/json;
            return 401 '{"error":"Unauthorized"}';
        }
        location ^~ /v1/ {
            default_type application/json;
            return 401 '{"error":"Unauthorized"}';
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }

    # Public TLS endpoint for XHTTP packet-up. Xray is reachable only
    # on the private Docker network, not published on the host.
    server {
        listen 9443 ssl;
        http2 on;
        server_name _;

        ssl_certificate     /etc/nginx/certs/server.crt;
        ssl_certificate_key /etc/nginx/certs/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;

        location ^~ __XHTTP_PATH__/ {
            proxy_pass http://xray:8083;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri $uri/ /index.html;
        }
    }
}
